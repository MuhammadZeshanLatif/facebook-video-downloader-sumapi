# React/Vite SPA on Apache - .htaccess
Options -Indexes

# Block access to hidden files and sensitive config files
<FilesMatch "(^\.|composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|\.env|\.gitignore|\.htaccess)$">
  Require all denied
</FilesMatch>

# Disable unsafe HTTP methods
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|DELETE|CONNECT) [NC]
  RewriteRule .* - [F,L]
</IfModule>

# Basic request filtering against common injection/malware payloads
# Note: no bot/user-agent blocking is used, so GitHub/search crawlers are unaffected.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{QUERY_STRING} (\.\./|%00|base64_|GLOBALS=|_REQUEST=|proc/self/environ|etc/passwd) [NC,OR]
  RewriteCond %{REQUEST_URI} (\.\./|/wp-admin|/wp-login|/xmlrpc\.php|/phpmyadmin|/administrator) [NC,OR]
  RewriteCond %{REQUEST_URI} (^|/)\.(git|svn|hg|bzr|env)(/|$) [NC,OR]
  RewriteCond %{REQUEST_URI} \.(bak|old|orig|save|swp|sql|ini|log|conf)$ [NC]
  RewriteRule .* - [F,L]
</IfModule>

# Block execution of uploaded server-side scripts (not needed for this static app)
<FilesMatch "\.(php|phtml|phar|cgi|pl|py|sh|asp|aspx|jsp)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Cross-Origin-Resource-Policy "same-site"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; media-src 'self' blob: https:; font-src 'self' data: https:; connect-src 'self' https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self';"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
